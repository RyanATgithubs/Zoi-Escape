# --- Large Assets (Keep these as LFS) ---
*.lib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text

# --- WebGL Safety Rules (FORCE these to be standard files) ---
# This overrides any previous LFS settings for your build
*.wasm !filter !diff !merge binary
*.data !filter !diff !merge binary
*.js   text
